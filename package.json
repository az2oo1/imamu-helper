{
  "name": "imamu-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "mkdir -p dist public && next build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist .next",
    "lint": "tsc --noEmit",
    "migrate": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "test": "tsx --test --test-concurrency=1 tests/auth_tier1.test.ts tests/auth_tier2.test.ts tests/auth_tier3.test.ts tests/auth_tier4.test.ts tests/challenger2_stress.test.ts tests/admin_management.test.ts tests/m5_m6.test.ts tests/challenger_phase2_adversarial.test.ts",
    "test:tier1": "tsx --test tests/auth_tier1.test.ts",
    "test:tier2": "tsx --test tests/auth_tier2.test.ts",
    "test:tier3": "tsx --test tests/auth_tier3.test.ts",
    "test:tier4": "tsx --test tests/auth_tier4.test.ts",
    "test:full": "tsx --test tests/full_app_crud.test.ts",
    "wizard": "tsx scripts/setup-wizard.ts",
    "create-user": "tsx scripts/setup-wizard.ts",
    "extract:courses": "node --experimental-websocket scripts/extract-courses.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@electric-sql/pglite": "^0.5.8",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "multer": "^2.3.0",
    "next": "^15.5.25",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
