# Host state directories used by docker-compose.yml:
#   /AppData/IMAMU/_DB                    -> PostgreSQL data directory
#   /AppData/IMAMU/Backupapp              -> Databasus (backup app) state + archives
#   /AppData/IMAMU/objectstorage/{config,meta,data} -> Garage S3 storage

# PostgreSQL Database Settings
# You can supply DATABASE_URL or individual SQL_* parameters:
SQL_HOST="100.66.191.44"
SQL_BACKUP_HOST="" # Secondary backup server for reliability/failover
SQL_PORT="5432"
SQL_USER="imamu"
SQL_PASSWORD="imamu_dev_password"
SQL_DB_NAME="imamu"
SQL_SSL="false"
DATABASE_URL="postgresql://imamu:imamu_dev_password@100.66.191.44:5432/imamu?sslmode=disable"
SQL_ADMIN_USER="imamu"
SQL_ADMIN_PASSWORD="imamu_dev_password"

# Databasus (PostgreSQL backup app) - read-only role used for dumps
IMAMU_BACKUP_PASSWORD="backup_dev_password"
DATABASUS_HOST_PORT="4005"

# Umami (self-hosted analytics) - create the website in the Umami UI and copy
# the website ID here, then restart the app container.
UMAMI_HOST_PORT="3006"
UMAMI_POSTGRES_DB="umami"
UMAMI_POSTGRES_USER="umami"
UMAMI_POSTGRES_PASSWORD="umami"
UMAMI_APP_SECRET="change_me_to_a_long_random_secret"
UMAMI_URL=""          # e.g. http://100.70.48.23:3006
UMAMI_WEBSITE_ID=""

# RustFS / S3-Compatible Object Storage Settings
# When configured, uploaded media will be stored directly in RustFS S3
S3_ENDPOINT="http://100.70.48.23:9000"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfspassword"
S3_BUCKET_NAME="imamu-uploads"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://100.70.48.23:9000/imamu-uploads"


# APP_URL: The URL where this applet is hosted.
APP_URL="http://100.70.48.23:3000"

# Clustering & Scalability Settings
# Set to "true" to disable background cron workers on API replica instances
DISABLE_BACKGROUND_WORKERS="false"
# Set to "true" in multi-replica / cluster production deployments to prevent split-brain PGlite fallback
DISABLE_PGLITE_FALLBACK="false"

# SMTP Settings for sending verification emails

